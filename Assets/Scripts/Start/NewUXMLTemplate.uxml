        <ui:Button text="Click to continue" name="nextButton" style="height: 88%; width: 346%; flex-basis: auto; -unity-text-align: middle-center; top: 70%; bottom: auto; right: 15%; left: auto; background-color: rgba(188, 188, 188, 0); color: rgb(255, 255, 255); -unity-font-style: bold; font-size: 30px; border-left-color: rgba(255, 255, 255, 0); border-right-color: rgba(255, 255, 255, 0); border-top-color: rgba(255, 255, 255, 0); border-bottom-color: rgba(255, 255, 255, 0); min-width: 50%; min-height: 10%; max-width: 70%; max-height: 15%; transform-origin: center;"/>
        <ui:Image name="Image" style="right: 70%; width: 10%; background-color: rgba(255, 255, 255, 0); bottom: 10%; height: 100%; transform-origin: center center 330px; background-size: 100% 150%; color: rgb(255, 237, 237);">
            <ui:Label text="" name="Name" language-direction="RTL" style="background-size: 10% 10%; width: 10%; height: 10%; font-size: 50px; top: auto; right: auto; left: 65%; -unity-text-outline-width: 0.5px; bottom: 50%; -unity-text-align: upper-right; -unity-text-outline-color: rgb(0, 0, 0); -unity-font-style: bold;"/>
        </ui:Image>
